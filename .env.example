# 本地 SQLite 数据库（Docker 镜像中为 file:/data/algostage.db）
DATABASE_URL="file:./algostage.db"

# BYOK：也可以不填，启动后在 /settings 页面配置（仅保存在本地）
# 使用环境变量 Key 时必须显式填写 AI_BASE_URL；设置页只能单独覆盖模型名。
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-6.1-sol

# 提示接口上游超时（毫秒），默认 60000
# HINT_TIMEOUT_MS=60000

# 服务端判题单进程并发上限（默认 4，最大 64）
# JUDGE_MAX_CONCURRENCY=4

# 以下在构建时生效，修改后需重新 build
# NEXT_PUBLIC_BASE_PATH=            # 子路径，如 /algostage
