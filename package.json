{
  "name": "algostage",
  "version": "0.3.1",
  "private": true,
  "description": "AlgoStage · 算法讲台 — 像老师讲课一样学算法，AI 讲到哪，聚光灯打到哪",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "postinstall": "prisma generate && npm run build:judge",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node --import tsx scripts/check-core-coverage.ts",
    "pretest:coverage": "npm run build:judge",
    "test:e2e": "playwright test",
    "build:judge": "node node_modules/tsx/dist/cli.mjs scripts/build-judge.ts",
    "prebuild": "npm run build:judge",
    "predev": "npm run build:judge",
    "pretest": "npm run build:judge"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.53",
    "@ai-sdk/google": "4.0.69",
    "@ai-sdk/openai-compatible": "3.0.48",
    "@ai-sdk/react": "4.0.102",
    "@monaco-editor/react": "4.7.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "ai": "7.0.99",
    "lucide-react": "1.45.0",
    "modern-screenshot": "4.7.0",
    "motion": "13.2.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "7.29.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.1",
    "prisma": "7.10.0",
    "pyodide": "314.0.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "3.24.5",
    "dompurify": "3.4.16"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
